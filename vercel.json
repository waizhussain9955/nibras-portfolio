{
  "version": 2,
  "routes": [
    {
      "src": "/api/leads",
      "dest": "/api/leads.js"
    },
    {
      "src": "/api/data",
      "dest": "/api/data.js"
    },
    {
      "src": "/api/save-data",
      "dest": "/api/data.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
